# Shared across every repo in this project so they all join the same
# docker compose default network (<project>_default) and can resolve
# each other by hostname (api, web, postgres).
COMPOSE_PROJECT_NAME=cobuccio_wallet

# Build config
ENV_RUN=development
NODE_ENV=
NODE_VERSION=
SYSTEM_VERSION=

# Docker external ports
DOCKER_API_PORT=4000
DOCKER_DB_PORT=5432

# Hosts (resolved between containers on the shared docker compose network)
API_HOST=api
PGHOST=postgres

# Database (Postgres)
PGPORT=5432
DATABASE_HOST=${PGHOST}
DATABASE_PORT=${PGPORT}
DATABASE_USERNAME=cobuccio_user
DATABASE_PASSWORD=cobuccio_password
DATABASE_NAME=cobuccio_wallet
# Only read in config.production.ts — set to "true" if the managed
# Postgres provider requires SSL. Defaults to off (no SSL) when unset.
DATABASE_SSL=

# Application
# Port the Nest app listens on. Defaults to 3000 in code when unset.
PORT=3000
# Origin allowed to call the API from the browser (CORS). Must be the
# web app's own URL, reachable from the browser — not a container hostname.
# Defaults to http://localhost:3000 in code when unset.
CORS_ORIGIN=http://localhost:${PORT}

# Authentication (JWT)
# Secret used to sign/verify access tokens. REQUIRED — the app refuses to
# start if this is empty (no hardcoded fallback). Generate with:
# openssl rand -base64 48
JWT_SECRET=
# Token lifetimes (access, refresh, inactivity) are NOT env vars — they're
# a security/product decision, the same in every environment, not
# something that varies per deploy. See AppConfig.Auth in src/config.ts.
# Flags for the auth cookies (access_token/refresh_token). "secure" must
# be true in any environment served over HTTPS; keep false for local HTTP
# dev. Defaults to false in code when unset.
COOKIE_SECURE=false
# "lax" works when the API and the web app share the same site (e.g. both
# on localhost, different ports). Switch to "none" (+ COOKIE_SECURE=true)
# if they end up on different registrable domains in production. Defaults
# to "lax" in code when unset.
COOKIE_SAME_SITE=lax

# Uploads (avatar)
# Folder where uploaded avatar files are saved on disk, relative to the
# project root. Defaults to "uploads/avatars" in code when unset.
UPLOADS_AVATARS_DIR=uploads/avatars
# Max accepted file size per upload, in bytes. Defaults to 2097152 (2MB)
# in code when unset.
UPLOAD_MAX_AVATAR_SIZE_BYTES=2097152
# Comma-separated list of accepted mime types. Defaults to
# "image/jpeg,image/png,image/webp" in code when unset.
UPLOAD_ALLOWED_AVATAR_MIME_TYPES=image/jpeg,image/png,image/webp

# Migrations (make migration-generate / migration-run / migration-revert)
# Those commands run yarn/ts-node directly on the host, not inside Docker,
# so they need Postgres's host-exposed address, not the "postgres"
# hostname above (which only resolves inside the compose network).
# Change this only if pointing migrations somewhere else (e.g. a deployed
# database) — note it must have a real value here, not be left empty: an
# empty-but-defined variable in .env bypasses the Makefile's `?=` default.
MIGRATION_DATABASE_HOST=127.0.0.1
